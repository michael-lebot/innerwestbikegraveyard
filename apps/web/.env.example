# Production environment of the web project on Vercel. Off Vercel every variable has a working default.

# Neon, pooled connection.
DATABASE_URL=
# The private Blob store for photos (§4.3), connected to the web and admin projects.
BLOB_READ_WRITE_TOKEN=
# The map tiles on the public Blob store. Defaults to /tiles/inner-west.pmtiles on this site.
NEXT_PUBLIC_TILES_URL=
# The key that hashes each visitor's cookie (§6): 32 or more random characters, e.g. `openssl rand -hex 32`.
HASH_SECRET=
# The token Vercel Cron sends to /api/cron/hourly (§5.4): 32 or more random characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=
# Michael's alerts about reported photos (§4.6), sent through Resend: the API key from the Resend account. Unset, as
# before Resend is set up, the alerts go to the function log instead, and Reported photos in the admin app has them all.
RESEND_API_KEY=
# Who the alerts go to: the Resend account's own address, until a domain is verified there.
ALERT_EMAIL_TO=
# Who they come from. Defaults to onboarding@resend.dev, which can email only the Resend account's owner.
ALERT_EMAIL_FROM=
# The admin app's address, which every alert links to, e.g. https://admin-example.vercel.app.
ADMIN_URL=
# Not set by hand: Vercel's system environment variables must stay exposed (the default), because
# NEXT_PUBLIC_VERCEL_ENV is what turns BotID on in the browser.
